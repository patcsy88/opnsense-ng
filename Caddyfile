{$SITE_ADDRESS:localhost} {
	# The traffic stream (ADR-0023) must reach the browser event by event: no compression.
	@compressible not path /api/v1/firewalls/*/traffic/stream
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@trafficstream path /api/v1/firewalls/*/traffic/stream
	handle @trafficstream {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
