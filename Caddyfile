{
	# Only needed behind a tunnel or proxy that terminates TLS (docs/deployment.md). Caddy then
	# believes X-Forwarded-For from these addresses only, so the audit log and the login rate limit
	# see the real client. The default trusts nothing outside this machine.
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS:localhost} {
	# The traffic stream (ADR-0023) must reach the browser event by event: no compression.
	@compressible not path /api/v1/firewalls/*/traffic/stream
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@trafficstream path /api/v1/firewalls/*/traffic/stream
	handle @trafficstream {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
