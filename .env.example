# Placeholders only. Generate real values locally; never commit them.
# Copy to .env and fill in. See docs/deployment.md.

# --- Required ---
POSTGRES_PASSWORD=CHANGE_ME
# At least 32 characters. Keys the CSRF HMAC; changing it invalidates sessions.
SESSION_SECRET=CHANGE_ME
# Fernet key. Comma-separated list supported for rotation (first key encrypts).
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME
# Public hostname(s) users browse to, comma-separated. Also refused as a firewall target.
ALLOWED_HOSTS=fw.example.internal
# Address Caddy serves. Use a real hostname for automatic TLS, or "localhost" for local testing.
SITE_ADDRESS=fw.example.internal

# --- Optional (defaults shown) ---
SESSION_TTL_MINUTES=60
# Empty = same-origin only. Otherwise e.g. https://fw.example.internal
ALLOWED_ORIGINS=
# Caddy's address on the compose network (matches the subnet in docker-compose.yml).
TRUSTED_PROXIES=172.30.0.0/24
# Empty = private ranges only (10/8, 172.16/12, 192.168/16, fc00::/7).
# Setting a value REPLACES the default; include a public CIDR only if you really need it.
ALLOWED_FIREWALL_NETWORKS=
# Must be true before any firewall may be saved with verify_tls=false. Prefer a per-firewall CA bundle.
ALLOW_INSECURE_TLS=false
